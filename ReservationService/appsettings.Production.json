{
  // See UserService/appsettings.Production.json for the full rationale on why every
  // value here is a deliberately-broken placeholder overridden by an environment
  // variable in Elastic Beanstalk, never edited directly on the deployed instance.
  //
  //   ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection
  //   Jwt__Secret                          -> Jwt:Secret
  //   Jwt__Issuer                          -> Jwt:Issuer
  //   Jwt__Audience                        -> Jwt:Audience
  //   ServiceUrls__UserService             -> ServiceUrls:UserService
  //   ServiceUrls__CatalogService          -> ServiceUrls:CatalogService

  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_VIA_ConnectionStrings__DefaultConnection_ENV_VAR"
  },

  "Jwt": {
    // Must be identical to UserService's Jwt:Secret — tokens are issued there and
    // validated here without a round-trip call.
    "Secret": "REPLACE_VIA_Jwt__Secret_ENV_VAR",
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryUsers",
    "ExpiresInSeconds": 86400
  },

  "ServiceUrls": {
    "UserService": "REPLACE_VIA_ServiceUrls__UserService_ENV_VAR",
    "CatalogService": "REPLACE_VIA_ServiceUrls__CatalogService_ENV_VAR"
  },

  // Hourly in production; this value has no placeholder since it isn't
  // environment-specific or sensitive.
  "WaitlistExpiryIntervalSeconds": 3600
}
