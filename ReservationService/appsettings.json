{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "urls": "http://localhost:5003",

  "ConnectionStrings": {
    "DefaultConnection": "InMemory"
  },

  "Jwt": {
    // Must match UserService exactly. Tokens are issued by UserService and validated
    // here without a round-trip call; the shared secret is what makes that possible.
    "Secret": "L1brary!M@nagement#JWT$Secr3t-Key-2025_Production-Grade-Token",
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryUsers",
    "ExpiresInSeconds": 86400
  },

  "ServiceUrls": {
    // ReservationService calls both other services:
    //   UserService  - to validate users and check reservation limits before creating a reservation
    //   CatalogService - to check availability and update available copy counts
    "UserService": "http://localhost:5001",
    "CatalogService": "http://localhost:5002"
  },

  // How often the waitlist-expiry background job runs (in seconds).
  // 3600 = hourly in production; lower this temporarily to verify the job fires during testing.
  "WaitlistExpiryIntervalSeconds": 3600
}
