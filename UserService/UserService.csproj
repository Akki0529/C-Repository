<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- BCrypt: one-way password hashing. Never store plaintext passwords. -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- FluentValidation: declarative request validation; pinned to 11.x because
         FluentValidation.AspNetCore 12.x removed the auto-validation pipeline. -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />

    <!-- JwtBearer: validates incoming Bearer tokens on protected endpoints.
         The same shared secret is configured in ReservationService so it can
         also validate tokens issued by this service. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />

    <!-- EF Core: ORM for User entity persistence. Design package is dev-only
         (PrivateAssets) and is used for migrations in production setup. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Swashbuckle: generates Swagger UI at /swagger for manual endpoint testing. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
