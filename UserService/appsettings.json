{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // UserService listens on port 5001. CatalogService=5002, ReservationService=5003.
  "urls": "http://localhost:5001",

  "ConnectionStrings": {
    // "InMemory" triggers in-memory DB in Program.cs; any real connection string triggers PostgreSQL.
    "DefaultConnection": "InMemory"
  },

  "Jwt": {
    // This secret is shared with ReservationService so it can validate tokens issued here.
    // In production, override this with the ASPNETCORE_Jwt__Secret environment variable.
    // Minimum 256 bits (32 bytes) for HS256; this key is 60+ characters.
    "Secret": "L1brary!M@nagement#JWT$Secr3t-Key-2025_Production-Grade-Token",
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryUsers",
    // 86400 seconds = 24 hours; matches the expiresIn value returned in the login response.
    "ExpiresInSeconds": 86400
  },

  "ServiceUrls": {
    // UserService calls ReservationService only for the profile endpoint (to fetch stats).
    "ReservationService": "http://localhost:5003"
  }
}
