{
  // Development overrides only. Port and JWT are already set in appsettings.json.
  // Override ConnectionStrings:DefaultConnection here to point to a local Postgres
  // instance if you want to test with a real database during development.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Log EF SQL queries in development so you can see exactly what hits the database.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
