{
  // See UserService/appsettings.Production.json for the full rationale on why every
  // value here is a deliberately-broken placeholder overridden by an environment
  // variable in Elastic Beanstalk, never edited directly on the deployed instance.
  //
  //   ConnectionStrings__CatalogDb -> ConnectionStrings:CatalogDb
  //
  // CatalogService needs no Jwt or ServiceUrls section — it validates no tokens and
  // calls no other service.

  "ConnectionStrings": {
    "CatalogDb": "REPLACE_VIA_ConnectionStrings__CatalogDb_ENV_VAR"
  }
}
