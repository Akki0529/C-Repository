{
  // ASP.NET Core layers this file on top of appsettings.json automatically when
  // ASPNETCORE_ENVIRONMENT=Production. Every value below is a placeholder meant to
  // be overridden by the real environment variables listed in
  // docs/milestone-5-deployment-production-readiness.md — none of these placeholders
  // will actually work, by design, so a misconfigured deploy fails loudly instead of
  // silently running against a fake database.
  //
  // Elastic Beanstalk env var name -> what it overrides here (double underscore ("__")
  // is ASP.NET Core's env-var path separator, equivalent to ":" in JSON):
  //   ConnectionStrings__UserDb            -> ConnectionStrings:UserDb
  //   Jwt__Secret                          -> Jwt:Secret
  //   Jwt__Issuer                          -> Jwt:Issuer
  //   Jwt__Audience                        -> Jwt:Audience
  //   ServiceUrls__ReservationService      -> ServiceUrls:ReservationService

  "ConnectionStrings": {
    // Must be a real Npgsql connection string in production. Key is "UserDb" (not
    // "DefaultConnection") so all three services share one EB environment without
    // each service overwriting the others' connection strings.
    "UserDb": "REPLACE_VIA_ConnectionStrings__UserDb_ENV_VAR"
  },

  "Jwt": {
    // Must be identical to ReservationService's Jwt:Secret — both are set from the
    // same secret value via each service's own Jwt__Secret environment variable.
    "Secret": "REPLACE_VIA_Jwt__Secret_ENV_VAR",
    "Issuer": "LibraryManagementSystem",
    "Audience": "LibraryUsers",
    "ExpiresInSeconds": 86400
  },

  "ServiceUrls": {
    "ReservationService": "REPLACE_VIA_ServiceUrls__ReservationService_ENV_VAR"
  }
}
